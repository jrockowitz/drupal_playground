+<?php
+
+/**
+ * @file
+ * Test hooks for page titles supplied as render arrays.
+ */
+
+/**
+ * Implements hook_preprocess_HOOK() for page titles.
+ */
+function type_tray_title_test_preprocess_page_title(array &$variables): void {
+  if (\Drupal::routeMatch()->getRouteName() === 'entity.node.edit_form') {
+    $variables['title'] = [
+      '#markup' => '<span class="original-title">Original title</span>',
+    ];
+  }
+}
diff --git a/tests/src/Functional/TitleIconTest.php b/tests/src/Functional/TitleIconTest.php
new file mode 100644
index 0000000..8685f30
--- /dev/null
+++ b/tests/src/Functional/TitleIconTest.php
@@ -0,0 +1,84 @@
+<?php
+
+namespace Drupal\Tests\type_tray\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests the decorative icon on node administration page titles.
+ *
+ * @group type_tray
+ */
+class TitleIconTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'block',
+    'node',
+    'type_tray',
+    'type_tray_title_test',
+  ];
+
+  /**
+   * Tests node routes, custom and default icons, and render array titles.
+   */
+  public function testTitleIcons(): void {
+    $this->drupalPlaceBlock('page_title_block');
+    $this->drupalLogin($this->drupalCreateUser([
+      'administer nodes',
+      'bypass node access',
+      'view all revisions',
+    ]));
+
+    $type = $this->drupalCreateContentType(['type' => 'article']);
+    $type->setThirdPartySetting('type_tray', 'type_icon',
+      '/modules/contrib/type_tray/assets/icons/book-open.svg');
+    $type->save();
+    $node = $this->drupalCreateNode(['type' => 'article']);
+
+    // Check the custom icon on the node add page.
+    $this->drupalGet('node/add/article');
+    $this->assertIcon('book-open.svg');
+
+    // Check the custom icon and an existing render array title on edit.
+    $this->drupalGet($node->toUrl('edit-form'));
+    $this->assertIcon('book-open.svg');
+    $this->assertSession()->elementExists('css', 'h1 .original-title');
+
+    // Check the custom icon on the delete confirmation page.
+    $this->drupalGet($node->toUrl('delete-form'));
+    $this->assertIcon('book-open.svg');
+
+    // Check the custom icon on the revisions page.
+    $this->drupalGet($node->toUrl('version-history'));
+    $this->assertIcon('book-open.svg');
+
+    // Check the default icon when the content type has no custom icon.
+    $type->unsetThirdPartySetting('type_tray', 'type_icon')->save();
+    $this->drupalGet($node->toUrl('edit-form'));
+    $this->assertIcon('file-text.svg');
+
+    // Check that the non-administration node view has no title icon.
+    $this->drupalGet($node->toUrl());
+    $this->assertSession()->elementNotExists('css', 'h1 img.type-tray-title');
+  }
+
+  /**
+   * Asserts that a page title contains the expected decorative icon.
+   */
+  private function assertIcon(string $filename): void {
+    // Check that the title has one decorative image with the expected source.
+    $this->assertSession()->elementsCount('css', 'h1 img.type-tray-title', 1);
+    $this->assertSession()->elementExists('css', 'h1 img.type-tray-title[alt=""]');
+    $this->assertSession()->elementAttributeContains(
+      'css', 'h1 img.type-tray-title', 'src', $filename);
+  }
+
+}
