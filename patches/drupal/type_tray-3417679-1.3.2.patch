diff --git a/src/Hook/ThemeHooks.php b/src/Hook/ThemeHooks.php
new file mode 100644
index 0000000..c8f18e5
--- /dev/null
+++ b/src/Hook/ThemeHooks.php
@@ -0,0 +1,106 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\type_tray\Hook;
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Extension\ModuleExtensionList;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Routing\AdminContext;
+use Drupal\Core\Routing\RouteMatchInterface;
+use Drupal\node\NodeInterface;
+use Drupal\node\NodeTypeInterface;
+use Drupal\type_tray\Controller\TypeTrayController;
+
+/**
+ * Theme hook implementations for the type_tray module.
+ */
+class ThemeHooks {
+
+  /**
+   * Creates a new ThemeHooks class.
+   */
+  public function __construct(
+    protected readonly ModuleExtensionList $moduleExtensionList,
+    protected readonly RouteMatchInterface $routeMatch,
+    protected readonly AdminContext $adminContext,
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+  ) {}
+
+  /**
+   * Implements hook_theme_registry_alter().
+   *
+   * Ensures that this module's page title preprocessor follows the theme's.
+   */
+  #[Hook('theme_registry_alter')]
+  public function themeRegistryAlter(array &$theme_registry): void {
+    $preprocess_functions = array_values(array_filter(
+      $theme_registry['page_title']['preprocess functions'],
+      static fn (string $function): bool => $function !== 'type_tray_preprocess_page_title',
+    ));
+    $preprocess_functions[] = 'type_tray_preprocess_page_title';
+    $theme_registry['page_title']['preprocess functions'] = $preprocess_functions;
+  }
+
+  /**
+   * Implements hook_preprocess_HOOK() for page title templates.
+   */
+  #[Hook('preprocess_page_title')]
+  public function preprocessPageTitle(array &$variables): void {
+    if (!$this->adminContext->isAdminRoute()) {
+      return;
+    }
+
+    $type = $this->getNodeTypeForPageTitle();
+    if ($type === NULL) {
+      return;
+    }
+
+    // The image theme generates the URL from this URI, including base paths.
+    $icon_uri = $type->getThirdPartySetting('type_tray', 'type_icon');
+    if (empty($icon_uri)) {
+      $module_path = $this->moduleExtensionList->getPath('type_tray');
+      $icon_uri = $module_path . TypeTrayController::TYPE_TRAY_DEFAULT_ICON_PATH;
+    }
+
+    // Preserve titles that other preprocessors have already made render arrays.
+    $title = is_array($variables['title'])
+      ? $variables['title']
+      : ['#markup' => $variables['title']];
+    $variables['title'] = [
+      'image' => [
+        '#theme' => 'image',
+        '#uri' => $icon_uri,
+        '#alt' => '',
+        '#attributes' => ['class' => ['type-tray-title']],
+        '#attached' => ['library' => ['type_tray/type_tray.title']],
+      ],
+      'title' => $title,
+    ];
+  }
+
+  /**
+   * Gets the node type associated with the current node administration route.
+   */
+  private function getNodeTypeForPageTitle(): ?NodeTypeInterface {
+    $route_name = $this->routeMatch->getRouteName();
+    if ($route_name === 'node.add') {
+      $type = $this->routeMatch->getParameter('node_type');
+      return $type instanceof NodeTypeInterface ? $type : NULL;
+    }
+
+    if (!str_starts_with($route_name ?? '', 'entity.node.')) {
+      return NULL;
+    }
+
+    $node = $this->routeMatch->getParameter('node');
+    if (!$node instanceof NodeInterface) {
+      return NULL;
+    }
+
+    $type = $this->entityTypeManager->getStorage('node_type')->load($node->bundle());
+    return $type instanceof NodeTypeInterface ? $type : NULL;
+  }
+
+}
