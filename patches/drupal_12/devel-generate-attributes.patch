+<?php
+
+namespace Drupal\devel_generate\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Defines a Devel Generate plugin.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class DevelGenerate extends Plugin {
+
+  /**
+   * Constructs a Devel Generate attribute.
+   */
+  public function __construct(
+    public readonly string $id,
+    public readonly TranslatableMarkup $label,
+    public readonly TranslatableMarkup $description,
+    public readonly string $url,
+    public readonly string $permission,
+    public readonly array $settings = [],
+    public readonly array $moduleDependencies = [],
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function get(): array {
+    $definition = parent::get();
+    $definition['dependencies'] = $this->moduleDependencies;
+    unset($definition['moduleDependencies']);
+    return $definition;
+  }
+
+}
