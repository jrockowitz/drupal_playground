{
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "drupal/webform",
        "type": "drupal-module-sandbox",
        "version": "6.2.x-dev",
        "source": {
          "url": "git@git.drupal.org:project/webform.git",
          "type": "git",
          "reference": "6.2.x"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/schemadotorg",
        "type": "drupal-module-sandbox",
        "version": "1.0.x-dev",
        "source": {
          "url": "git@git.drupal.org:project/schemadotorg.git",
          "type": "git",
          "reference": "1.0.x"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/schemadotorg_experimental",
        "type": "drupal-module-sandbox",
        "version": "1.0.x-dev",
        "source": {
          "url": "git@git.drupal.org:project/schemadotorg_experimental.git",
          "type": "git",
          "reference": "1.0.x"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/schemadotorg_deprecated",
        "type": "drupal-module-sandbox",
