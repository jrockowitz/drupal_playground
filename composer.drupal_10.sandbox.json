          "url": "git@git.drupal.org:project/schemadotorg_deprecated.git",
          "type": "git",
          "reference": "1.0.x"
        }
      }
    }
  ],
  "require": {
    "drupal/schemadotorg": "1.0.x-dev",
    "drupal/schemadotorg_deprecated": "1.0.x-dev",
    "drupal/schemadotorg_experimental": "1.0.x-dev",
    "drupal/webform": "6.2.x-dev"
  },
  "extra": {
    "merge-plugin": {
      "include": [
        "web/modules/sandbox/schemadotorg/composer.json",
        "web/modules/sandbox/schemadotorg_deprecated/composer.json",
        "web/modules/sandbox/schemadotorg_experimental/composer.json",
