#!/bin/bash
# cspell:ignore pipefail milvus esac

set -euo pipefail

## Description: Install Drupal with one or more presets.
## Usage: install <preset...> [--limit=10] [--query=QUERY]
## Example: ddev install site\nddev install ai\nddev install ckeditor\nddev install openai\nddev install anthropic\nddev install gemini\nddev install anthropic ai\nddev install eca\nddev install elastic\nddev install entity-usage\nddev install schemadotorg\nddev install translation\nddev install webform-setup\nddev install webform-ai\nddev install webform-test\nddev install trials\nddev install trials-fields\nddev install trials-fields-setup\nddev install trials-fields-setup --limit=50 --query="query.cond=Cancer&query.locn=New%20York&filter.overallStatus=RECRUITING%7CNOT_YET_RECRUITING"\nddev install trials-data-setup trials-data-elastic --limit=50 --query="query.cond=Cancer&query.locn=New%20York&filter.overallStatus=RECRUITING%7CNOT_YET_RECRUITING"\nddev install trials-fields-elastic\nddev install trials-fields-milvus\nddev install trials-data-setup\nddev install trials-data-elastic\nddev install trials-data-milvus\nddev install trials-data-elastic trials-data-milvus
## Milvus indexing throttles provider requests by running 5 passes of 200 items with 30 second pauses.
## ProjectTypes: drupal,drupal11

uli_path="/"
LIMIT="10"
QUERY=""
QUERY_IS_SET="false"
DRUPAL_VERSION=""
DRUPAL_MAJOR_VERSION=""
PRESETS=()

# Display supported presets, options, and examples.
usage() {
  cat <<'EOF'
Usage: ddev install <preset...> [--limit=10] [--query=QUERY]

Install Drupal with one or more presets. Every install replaces the database.
Use site for the default installation. Presets can be combined.

Presets:
  site                     Default installation with no additional preset recipes.

  # AI
  ai                       AI chat, CKEditor, content suggestions, automation, and Schema.org JSON-LD demos.
  openai                   Configure the OpenAI provider (the default provider).
  anthropic                Configure the Anthropic provider.
  gemini                   Configure the Gemini provider.

  # Demos
  ckeditor                 CKEditor demo.
  eca                      ECA Starterkit demo.
  elastic                  Elasticsearch demo.
  entity-usage             Entity Usage demo with rebuilt usage and root data.
  translation              Translation demo with updated translations.

  # Schema.org Blueprints
  schemadotorg             Schema.org Blueprints and API demos.

  # Webform
  webform                  Webform setup (alias of webform-setup).
  webform-setup            Webform setup.
  webform-ai               Webform setup and AI Webform Generator.
  webform-test             Webform test recipe and test modules.

  # ClinicalTrials.gov
  trials                   Enable ClinicalTrials.gov modules.
  trials-fields            Run fields setup, Elasticsearch, and Milvus flows.
  trials-fields-setup      Fields setup and study import.
  trials-fields-elastic    Fields Elasticsearch indexing.
  trials-fields-milvus     Fields Milvus indexing.
  trials-data              Run data setup, Elasticsearch, and Milvus flows.
  trials-data-setup        Data setup and study import.
  trials-data-elastic      Data Elasticsearch import and indexing.
  trials-data-milvus       Data Milvus indexing.

Options:
  --limit=NUMBER  Study import limit (default: 10).
  --query=QUERY   ClinicalTrials.gov query for fields/data setup.

Examples:
  ddev install site
  ddev install anthropic ai
  ddev install webform
  ddev install webform-ai
  ddev install schemadotorg
  ddev install trials-fields-setup --limit=50 --query="query.cond=Cancer"
EOF
}

# Validate one preset and display usage when it is unsupported.
preset_validate() {
  local preset="$1"

  # Accept supported presets, grouped by feature.
  case "$preset" in
    site|ai|ckeditor|openai|anthropic|gemini|\
    schemadotorg|eca|elastic|entity-usage|translation|\
    webform|webform-setup|webform-ai|webform-test|\
    trials|trials-fields|trials-fields-setup|trials-fields-elastic|trials-fields-milvus|\
    trials-data|trials-data-setup|trials-data-elastic|trials-data-milvus)
      return 0
      ;;

    *)
      printf 'Invalid preset: %s\n\n' "$preset" >&2
      usage >&2
      return 1
      ;;
  esac
}

# Expand convenience presets in place while preserving the requested order.
presets_expand() {
  local preset
  local expanded_presets=()

  # Replace aliases with their setup and indexing flows.
  for preset in "${PRESETS[@]}"; do
    case "$preset" in
      trials-data)
        expanded_presets+=("trials-data-setup" "trials-data-elastic" "trials-data-milvus")
        ;;

      trials-fields)
        expanded_presets+=("trials-fields-setup" "trials-fields-elastic" "trials-fields-milvus")
        ;;

      *)
        expanded_presets+=("$preset")
        ;;
    esac
  done

  # Use the expanded list for the installation.
  PRESETS=("${expanded_presets[@]}")
}

# Reset and index ClinicalTrials.gov studies in Milvus with provider throttling.
search_api_index_trials_milvus() {
  echo "Resetting ClinicalTrials.gov studies in Milvus..."
  drush search-api:clear trials_milvus -y

  echo "Indexing ClinicalTrials.gov studies in Milvus..."
  drush search-api:index trials_milvus --limit=200 -y
  sleep 30
  drush search-api:index trials_milvus --limit=200 -y
  sleep 30
  drush search-api:index trials_milvus --limit=200 -y
  sleep 30
  drush search-api:index trials_milvus --limit=200 -y
  sleep 30
  drush search-api:index trials_milvus --limit=200 -y
}

# Reset and index ClinicalTrials.gov studies in Elasticsearch.
search_api_index_trials_elasticsearch() {
  echo "Resetting ClinicalTrials.gov studies in Elasticsearch..."
  curl -fsS -X DELETE "http://elasticsearch:9200/trials_elasticsearch" >/dev/null 2>&1 || true
  drush search-api:clear trials_elasticsearch -y

  echo "Indexing ClinicalTrials.gov studies in Elasticsearch..."
  drush search-api:index trials_elasticsearch -y;
}

# Parse --options for limit and query.
for argument in "$@"; do
  case "$argument" in
    --limit=*)
      LIMIT="${argument#*=}"
      ;;

    --query=*)
      QUERY="${argument#*=}"
      QUERY_IS_SET="true"
      ;;

    *)
      PRESETS+=("$argument")
      ;;
  esac
done

# Display usage when no preset was supplied.
if [ "${#PRESETS[@]}" -eq 0 ]; then
  usage
  exit 0
fi

# Validate all presets before any installation commands run.
for preset in "${PRESETS[@]}"; do
  preset_validate "$preset" || exit 1
done

# Expand convenience presets into their corresponding flows.
presets_expand

drush sql:drop -y

drush site:install standard \
  --db-url=mysql://db:db@db/db \
  --site-name="Drupal Playground" \
  --account-name=admin \
  --account-pass=admin \
  --account-mail=admin@example.com \
  --yes

DRUPAL_VERSION="$(drush php:eval 'echo \Drupal::VERSION;')"
DRUPAL_MAJOR_VERSION="${DRUPAL_VERSION%%.*}"

/mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_base

/mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_admin

if [ "$DRUPAL_MAJOR_VERSION" -le 10 ]; then
  # Apply Gin as the admin theme for Drupal 10 installs.
  /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_admin_gin

  # Uninstall the toolbar module, which can't be done via a recipe.
  drush pm:uninstall -y toolbar

  # Uninstall core modules that are not used in any demos.
  drush php:eval '\Drupal\field\Entity\FieldConfig::loadByName("node", "article", "comment")->delete();'
  drush pmu -y comment
else
  # Apply Default Admin as the admin theme for Drupal 11 installs.
  /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_admin_default

  # Uninstall Claro after Default Admin is installed and selected.
  drush theme:uninstall -y claro
fi

/mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_devel
/mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai
/mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_devel

# Set AI provider configuration before applying other presets.
provider_installed="false"
for PRESET in "${PRESETS[@]}"; do
  if [ "$PRESET" = "openai" ] || [ "$PRESET" = "anthropic" ] || [ "$PRESET" = "gemini" ]; then
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_provider_${PRESET}
    provider_installed="true"
  fi
done
# Apply the OpenAI provider recipe when no provider was requested.
if [ "$provider_installed" = "false" ]; then
  /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_provider_openai
fi

# Apply presets.
for PRESET in "${PRESETS[@]}"; do
  if [ "$PRESET" = "ai" ]; then

    echo "Applying AI recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_chat
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_ckeditor
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_content_suggestions
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_devel
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_automators
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_ckeditor_explain

    echo "Applying AI Schema.org JSON-LD recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ai_schemadotorg_jsonld
    uli_path="/admin/config/ai"

  fi

  if [ "$PRESET" = "ckeditor" ]; then

    echo "Applying Drupal Playground CKEditor recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_ckeditor
    uli_path="/node/1"

  fi

  if [ "$PRESET" = "schemadotorg" ]; then

    echo "Applying Schema.org Blueprints recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_schemadotorg
    echo "Applying Schema.org Blueprints API recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_schemadotorg_api
    uli_path="/admin/config/schemadotorg"

  fi

  if [ "$PRESET" = "eca" ]; then

    echo "Applying ECA Starterkit recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_eca
    uli_path="/admin/config/workflow/eca"

  fi

  if [ "$PRESET" = "elastic" ]; then

    echo "Resetting ClinicalTrials.gov studies in Elasticsearch..."
    curl -fsS -X DELETE "http://elasticsearch:9200/drupal_playground_elasticsearch" >/dev/null 2>&1 || true
    echo "Applying Elasticsearch recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_elasticsearch
    uli_path="/elasticsearch"

  fi

  if [ "$PRESET" = "entity-usage" ]; then

    echo "Applying Entity Usage recipe..."
    /mnt/ddev_config/commands/web/recipe-apply modules/sandbox/entity_usage_root/tests/recipes/entity_usage_root_test_recipe
    echo "Rebuilding entity usage data..."
    drush entity-usage:recreate
    echo "Rebuilding entity usage roots..."
    drush entity-usage-root:rebuild
    uli_path="/admin/content/media/root-node"

  fi

  if [ "$PRESET" = "translation" ]; then

    echo "Applying translation recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_translation
    drush locale-check
    drush locale-update

  fi

  # Webform

  if [ "$PRESET" = "webform" ] || [ "$PRESET" = "webform-setup" ] || [ "$PRESET" = "webform-ai" ]; then

    echo "Applying Webform setup recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_webform_setup
    uli_path="/admin/structure/webform"

  fi

  if [ "$PRESET" = "webform-test" ]; then

    echo "Applying Webform test recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_webform_test
    echo "Enabling Webform node multiple and submissions test modules..."
    drush en -y webform_node_test_multiple webform_test_submissions
    uli_path="/admin/structure/webform"

  fi

  if [ "$PRESET" = "webform-ai" ]; then

    echo "Applying AI Webform Generator recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/drupal_playground_webform_ai
    uli_path="/admin/structure/webform/ai-generator"

  fi

  # Trials

  if [ "$PRESET" = "trials" ]; then

    echo "Installing ClinicalTrials.gov module..."
    drush en -y readonly_field_widget clinical_trials_gov clinical_trials_gov_report
    uli_path="/admin/config/services/clinical-trials-gov"

  fi

  # Trials: Fields

  if [ "$PRESET" = "trials-fields-setup" ]; then

    echo "Applying ClinicalTrials.gov fields setup recipe..."
    recipe_arguments=(../recipes/clinical_trials_gov_recipe_fields_setup)
    if [ "$QUERY_IS_SET" = "true" ]; then
      recipe_arguments+=(--input="clinical_trials_gov_recipe_fields_setup.query=$QUERY")
    fi
    /mnt/ddev_config/commands/web/recipe-apply "${recipe_arguments[@]}"
    echo "Importing ClinicalTrials.gov studies..."
    drush migrate:import clinical_trials_gov --limit="$LIMIT"
    echo "Running AI Automator queue..."
    drush queue:run ai_automator_field_modifier
    uli_path="/admin/config/services/clinical-trials-gov"

  fi

  if [ "$PRESET" = "trials-fields-elastic" ]; then

    echo "Applying ClinicalTrials.gov fields Elasticsearch recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/clinical_trials_gov_recipe_fields_elastic
    search_api_index_trials_elasticsearch
    uli_path="/trials"

  fi

  if [ "$PRESET" = "trials-fields-milvus" ]; then

    echo "Applying ClinicalTrials.gov fields Milvus recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/clinical_trials_gov_recipe_fields_milvus
    search_api_index_trials_milvus
    uli_path="/trials"

  fi

  # Trials: Data

  if [ "$PRESET" = "trials-data-setup" ]; then

    echo "Applying ClinicalTrials.gov data setup recipe..."
    recipe_arguments=(../recipes/clinical_trials_gov_recipe_data_setup)
    if [ "$QUERY_IS_SET" = "true" ]; then
      recipe_arguments+=(--input="clinical_trials_gov_recipe_data_setup.query=$QUERY")
    fi
    /mnt/ddev_config/commands/web/recipe-apply "${recipe_arguments[@]}"
    echo "Importing ClinicalTrials.gov studies..."
    drush migrate:import clinical_trials_gov --limit="$LIMIT"
    uli_path="/admin/config/services/clinical-trials-gov"

  fi

  if [ "$PRESET" = "trials-data-elastic" ]; then

    echo "Applying ClinicalTrials.gov data Elasticsearch recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/clinical_trials_gov_recipe_data_elastic
    echo "Importing ClinicalTrials.gov studies..."
    drush migrate:import clinical_trials_gov --limit="$LIMIT"
    search_api_index_trials_elasticsearch
    uli_path="/trials"

  fi

  if [ "$PRESET" = "trials-data-milvus" ]; then

    echo "Applying ClinicalTrials.gov data Milvus recipe..."
    /mnt/ddev_config/commands/web/recipe-apply ../recipes/clinical_trials_gov_recipe_data_milvus
    search_api_index_trials_milvus
    uli_path="/trials"

  fi
done

# Temp: Fix coffee navigation placement.
# @see https://www.drupal.org/project/coffee/issues/3535874#comment-16763706
drush eval "\Drupal::classResolver(\Drupal\coffee\CoffeeNavigationPlacement::class)->sync()"

drush cr;

echo ""
echo "Installation complete. One-time login URL:"
drush uli "$uli_path"
