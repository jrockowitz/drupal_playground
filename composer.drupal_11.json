{
    "repositories": [
        {
            "type": "path",
            "url": "recipes/drupal_playground_eca"
        }
    ],
    "require": {
        "drupal/ai_schemadotorg_jsonld": "*",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/core-recipe-unpack": "^11",
        "drupal/drupal_playground_eca": "*"
    },
    "require-dev": {
        "drupal/core-dev": "^11"
    },
    "config": {
        "allow-plugins": {
            "drupal/core-recipe-unpack": true
        }
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "web/modules/custom/clinical_trials_gov/composer.json"
            ]
        }
    }
}
