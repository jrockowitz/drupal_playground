{
    "repositories": [
        {
            "type": "path",
            "url": "recipes/drupal_playground_eca"
        }
    ],
    "conflict": {
        "drupal/core": "11.4.4",
        "drupal/core-composer-scaffold": "11.4.4",
        "drupal/core-dev": "11.4.4",
        "drupal/core-project-message": "11.4.4",
        "drupal/core-recommended": "11.4.4"
    },
    "require": {
        "drupal/core-recipe-unpack": "^11",
        "drupal/drupal_playground_eca": "*"
    },
    "config": {
        "allow-plugins": {
            "drupal/core-recipe-unpack": true
        }
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "web/modules/custom/clinical_trials_gov/composer.json"
            ]
        }
    }
}
